    <name>釜山慶州精選旅遊地圖 (含四大活動區域範圍填色版)</name>
    <description>包含圖層分區、色彩標記、星級評分、評價數、實景圖片與區域範圍填色 (海雲臺、西面、慶州古蹟、機張樂園區)</description>

    <!-- 景點樣式 -->
    <Style id="gyeongju-style">
      <IconStyle>
        <color>ff00a5ff</color>
        <scale>1.2</scale>
        <Icon><href>http://maps.google.com/mapfiles/kml/paddle/orange-blank.png</href></Icon>
      </IconStyle>
    </Style>
    <Style id="haeundae-style">
      <IconStyle>
        <color>ffff9900</color>
        <scale>1.2</scale>
        <Icon><href>http://maps.google.com/mapfiles/kml/paddle/blu-blank.png</href></Icon>
      </IconStyle>
    </Style>
    <Style id="attraction-style">
      <IconStyle>
        <color>ffff0080</color>
        <scale>1.2</scale>
        <Icon><href>http://maps.google.com/mapfiles/kml/paddle/purple-blank.png</href></Icon>
      </IconStyle>
    </Style>
    <Style id="hotel-style">
      <IconStyle>
        <color>ffb6c1ff</color>
        <scale>1.2</scale>
        <Icon><href>http://maps.google.com/mapfiles/kml/paddle/pink-blank.png</href></Icon>
      </IconStyle>
    </Style>
    <Style id="shopping-style">
      <IconStyle>
        <color>ff00bb00</color>
        <scale>1.2</scale>
        <Icon><href>http://maps.google.com/mapfiles/kml/paddle/grn-blank.png</href></Icon>
      </IconStyle>
    </Style>

    <!-- 區域範圍填色樣式 (AABBGGRR: 40 = 25% 標籤透明度) -->
    <!-- 1. 海雲臺區域 (透藍色) -->
    <Style id="poly-haeundae">
      <LineStyle><color>ff0088ff</color><width>2.5</width></LineStyle>
      <PolyStyle><color>45ff9900</color><fill>1</fill><outline>1</outline></PolyStyle>
    </Style>

    <!-- 2. 西面購物區 (透珊瑚橘) -->
    <Style id="poly-seomyeon">
      <LineStyle><color>ff0055ff</color><width>2.5</width></LineStyle>
      <PolyStyle><color>450066ff</color><fill>1</fill><outline>1</outline></PolyStyle>
    </Style>

    <!-- 3. 慶州古蹟區 (透森林綠) -->
    <Style id="poly-gyeongju">
      <LineStyle><color>ff00aa33</color><width>2.5</width></LineStyle>
      <PolyStyle><color>4500aa33</color><fill>1</fill><outline>1</outline></PolyStyle>
    </Style>

    <!-- 4. 機張樂園區 (透紫金黃) -->
    <Style id="poly-gijang">
      <LineStyle><color>ffaa00aa</color><width>2.5</width></LineStyle>
      <PolyStyle><color>45aa00aa</color><fill>1</fill><outline>1</outline></PolyStyle>
    </Style>

