    <name>釜山慶州精選旅遊地圖 (含雙家庭 17 大熱門景點美食與分區範圍)</name>
    <description>包含老婆與朋友最新加入的西面燒肉、活烤鰻魚、螞蟻家、市民公園與 Running Man 體驗館等 17 個精選點位與四大區域範圍填色</description>

    <!-- 景點樣式定義 -->
    <Style id="gyeongju-style">
      <IconStyle>
        <color>ff00a5ff</color>
        <scale>1.2</scale>
        <Icon><href>http://maps.google.com/mapfiles/kml/paddle/orange-blank.png</href></Icon>
      </IconStyle>
    </Style>
    <Style id="haeundae-style">
      <IconStyle>
        <color>ffff9900</color>
        <scale>1.2</scale>
        <Icon><href>http://maps.google.com/mapfiles/kml/paddle/blu-blank.png</href></Icon>
      </IconStyle>
    </Style>
    <Style id="attraction-style">
      <IconStyle>
        <color>ffff0080</color>
        <scale>1.2</scale>
        <Icon><href>http://maps.google.com/mapfiles/kml/paddle/purple-blank.png</href></Icon>
      </IconStyle>
    </Style>
    <Style id="hotel-style">
      <IconStyle>
        <color>ffb6c1ff</color>
        <scale>1.2</scale>
        <Icon><href>http://maps.google.com/mapfiles/kml/paddle/pink-blank.png</href></Icon>
