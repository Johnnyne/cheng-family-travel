        <color>ff00bb00</color>
        <scale>1.2</scale>
        <Icon><href>http://maps.google.com/mapfiles/kml/paddle/grn-blank.png</href></Icon>
      </IconStyle>
    </Style>
    <Style id="food-style">
      <IconStyle>
        <color>ff0045ff</color>
        <scale>1.2</scale>
        <Icon><href>http://maps.google.com/mapfiles/kml/paddle/red-blank.png</href></Icon>
      </IconStyle>
    </Style>

    <!-- 區域範圍填色樣式 -->
    <Style id="poly-haeundae">
      <LineStyle><color>ff0088ff</color><width>2.5</width></LineStyle>
      <PolyStyle><color>45ff9900</color><fill>1</fill><outline>1</outline></PolyStyle>
    </Style>
    <Style id="poly-seomyeon">
      <LineStyle><color>ff0055ff</color><width>2.5</width></LineStyle>
      <PolyStyle><color>450066ff</color><fill>1</fill><outline>1</outline></PolyStyle>
    </Style>
    <Style id="poly-gyeongju">
      <LineStyle><color>ff00aa33</color><width>2.5</width></LineStyle>
      <PolyStyle><color>4500aa33</color><fill>1</fill><outline>1</outline></PolyStyle>
    </Style>
    <Style id="poly-gijang">
      <LineStyle><color>ffaa00aa</color><width>2.5</width></LineStyle>
      <PolyStyle><color>45aa00aa</color><fill>1</fill><outline>1</outline></PolyStyle>
    </Style>

